---
import Base from '../layouts/Base.astro';
import ArrowDial from '../components/ArrowDial.astro';
---

<Base title="Off route">
  <section class="container-x flex min-h-[70svh] flex-col items-center justify-center gap-8 py-20 text-center">
    <ArrowDial size={160} angle={-90} interactive={false} />
    <div>
      <p class="label">404</p>
      <h1 class="mt-3 text-4xl font-semibold">You’re off route.</h1>
      <p class="mt-4 text-muted">This page doesn’t exist. The arrow points home.</p>
    </div>
    <a href="/" class="inline-flex items-center gap-2 font-medium">
      <span class="go-arrow">←</span>
      <span class="border-b border-accent pb-0.5">Back to the start</span>
    </a>
  </section>
</Base>
