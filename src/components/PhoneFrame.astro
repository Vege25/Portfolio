---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  width?: number;
  loading?: 'eager' | 'lazy';
}
const { src, alt, class: className = '', width = 300, loading = 'lazy' } = Astro.props;
---

<div
  class:list={[
    'overflow-hidden rounded-[1.75rem] border border-line-strong bg-raised p-1.5 shadow-[0_30px_60px_-30px_rgba(0,0,0,0.8)]',
    className,
  ]}
>
  <Image
    src={src}
    alt={alt}
    width={width}
    densities={[1, 2]}
    loading={loading}
    class="block h-auto w-full rounded-[1.35rem]"
  />
</div>
