---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhoneFrame from './PhoneFrame.astro';
import AuraFace from './AuraFace.astro';
import GpsCover from './GpsCover.astro';

interface Props {
  kind: 'phones' | 'wide' | 'aura' | 'gps';
  images: ImageMetadata[];
  alt: string;
  eager?: boolean;
  /** "row" = home page card (4:3), "hero" = wide header on a case page */
  variant?: 'row' | 'hero';
}
const { kind, images, alt, eager = false, variant = 'row' } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const hero = variant === 'hero';
const frame = hero ? 'aspect-[4/3] sm:aspect-[2/1]' : 'aspect-[4/3]';
---

{
  kind === 'phones' && (
    <div class:list={['relative flex items-end justify-center overflow-hidden rounded-lg border border-line bg-raised px-6 pt-10', frame]}>
      <div class:list={['flex items-end gap-3 sm:gap-5', hero ? 'translate-y-[18%] sm:translate-y-[28%]' : 'translate-y-[18%]']}>
        {images[1] && (
          <PhoneFrame
            src={images[1]}
            alt=""
            width={260}
            loading={loading}
            class:list={['hidden min-w-0 translate-y-6 opacity-80 sm:block', hero ? 'w-52 lg:w-64' : 'w-[30%]']}
          />
        )}
        {images[0] && (
          <PhoneFrame
            src={images[0]}
            alt={alt}
            width={320}
            loading={loading}
            class:list={['min-w-0', hero ? 'w-[56%] sm:w-64 lg:w-80' : 'w-[56%] sm:w-[36%]']}
          />
        )}
        {images[2] && (
          <PhoneFrame
            src={images[2]}
            alt=""
            width={260}
            loading={loading}
            class:list={['hidden min-w-0 translate-y-6 opacity-80 sm:block', hero ? 'w-52 lg:w-64' : 'w-[30%]']}
          />
        )}
      </div>
    </div>
  )
}

{
  kind === 'wide' && (
    <div class:list={['relative overflow-hidden rounded-lg border border-line bg-raised', frame]}>
      {images[0] && (
        <Image
          src={images[0]}
          alt={alt}
          width={1400}
          loading={loading}
          class:list={[
            'absolute max-w-none rounded-md border border-line-strong shadow-[0_30px_60px_-30px_rgba(0,0,0,0.9)]',
            hero ? 'left-[8%] top-[10%] w-[84%]' : 'left-[6%] top-[9%] w-[112%]',
          ]}
        />
      )}
      {images[1] && (
        <div
          class:list={[
            'absolute overflow-hidden rounded-[1.25rem] border border-line-strong bg-raised p-1 shadow-[0_30px_60px_-20px_rgba(0,0,0,0.9)]',
            hero ? 'bottom-[-40%] right-[4%] w-[17%]' : 'bottom-[-30%] right-[4%] w-[24%]',
          ]}
        >
          <Image src={images[1]} alt="" width={300} densities={[1, 2]} loading={loading} class="block h-auto w-full rounded-[1rem]" />
        </div>
      )}
    </div>
  )
}

{
  kind === 'aura' && (
    <div class:list={['flex items-center justify-center overflow-hidden rounded-lg border border-line bg-raised', frame]}>
      <AuraFace size={hero ? '22rem' : '18rem'} caption={false} />
    </div>
  )
}

{
  kind === 'gps' && (
    <div class={frame}>
      <GpsCover />
    </div>
  )
}
