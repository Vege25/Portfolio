---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div
    class="container-x flex flex-col gap-3 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {site.name} · {site.city}, Finland</p>
    <ul class="flex gap-5">
      <li><a class="hover:text-ink" href={site.links.github} rel="me">GitHub</a></li>
      <li><a class="hover:text-ink" href={site.links.linkedin} rel="me">LinkedIn</a></li>
      <li><a class="hover:text-ink" href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </div>
</footer>
