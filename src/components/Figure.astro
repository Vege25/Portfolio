---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
}
const { src, alt, caption, width = 1200 } = Astro.props;
---

<figure class="breakout">
  <div class="overflow-hidden rounded-lg border border-line bg-raised">
    <Image src={src} alt={alt} width={width} class="block h-auto w-full" loading="lazy" />
  </div>
  {caption && <figcaption class="label mt-3 normal-case tracking-normal">{caption}</figcaption>}
</figure>
