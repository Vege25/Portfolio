---
/**
 * The school projects list. Each row opens a dialog with a larger screenshot;
 * the code links stay in the row so they work without opening it.
 */
import { Image } from 'astro:assets';
import { earlier } from '../data/site';

---

<ul>
  {
    earlier.map((p, i) => (
      <li class="flex flex-col gap-3 border-t border-line py-5 first:border-t-0 first:pt-0 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
        <button
          type="button"
          data-open={`earlier-${i}`}
          aria-haspopup="dialog"
          class="earlier-row group/row grid grid-cols-[4.5rem_1fr] gap-4 text-left sm:grid-cols-[6.5rem_1fr] sm:gap-6"
        >
          <span class="relative block overflow-hidden rounded border border-line transition-colors group-hover/row:border-line-strong">
            <Image
              src={p.image}
              alt=""
              width={208}
              height={130}
              fit="cover"
              position="top"
              class="aspect-[16/10] w-full object-cover object-top opacity-80 transition duration-500 ease-[var(--ease-out-soft)] group-hover/row:scale-105 group-hover/row:opacity-100"
              loading="lazy"
            />
          </span>
          <span class="block">
            <span class="flex items-center gap-2 font-semibold">
              {p.name}
              <span class="font-mono text-[0.6875rem] font-normal text-faint transition-colors group-hover/row:text-accent">
                View
              </span>
            </span>
            <span class="mt-1 block text-sm text-muted">{p.text}</span>
            <span class="mt-2 block font-mono text-[0.6875rem] text-faint">{p.stack.join(' · ')}</span>
          </span>
        </button>
        <div class="flex shrink-0 gap-4 pl-[5.5rem] text-sm sm:pl-0 sm:pt-0.5">
          {p.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1">
              <span class="link">{l.label}</span>
              <span class="go-arrow out text-accent">↗</span>
            </a>
          ))}
        </div>
      </li>
    ))
  }
</ul>

{
  earlier.map((p, i) => (
    <dialog id={`earlier-${i}`} class="earlier-dialog" aria-labelledby={`earlier-${i}-title`}>
      <div class="relative">
        <div class="max-h-[58dvh] overflow-hidden border-b border-line bg-bg">
          <Image
            src={p.image}
            alt={`Screenshot of ${p.name}.`}
            widths={[800, 1600]}
            sizes="(min-width: 60rem) 56rem, 100vw"
            class="block h-auto w-full object-cover object-top"
            loading="lazy"
          />
        </div>
        <button
          type="button"
          data-close
          class="absolute right-3 top-3 grid h-10 w-10 place-items-center rounded-full border border-line-strong bg-bg/80 text-lg text-ink backdrop-blur transition-colors hover:border-muted"
          aria-label="Close"
        >
          ×
        </button>
      </div>
      <div class="grid gap-6 p-6 sm:grid-cols-[1fr_auto] sm:items-end sm:p-8">
        <div>
          <p class="label">School project · {p.year}</p>
          <h3 id={`earlier-${i}-title`} class="mt-3 text-3xl font-semibold">
            {p.name}
          </h3>
          <p class="mt-3 max-w-xl text-[#d6d4cd]">{p.text}</p>
          <p class="mt-4 font-mono text-xs text-muted">{p.stack.join(' · ')}</p>
        </div>
        <div class="flex gap-5">
          {p.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5">
              <span class="link">{l.label}</span>
              <span class="go-arrow out text-accent">↗</span>
            </a>
          ))}
        </div>
      </div>
    </dialog>
  ))
}

<style>
  .earlier-dialog {
    margin: auto;
    width: min(56rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    padding: 0;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.75rem;
    background: var(--color-raised);
    color: var(--color-ink);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.9);
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition:
      opacity 0.3s var(--ease-out-soft),
      transform 0.3s var(--ease-out-soft),
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }
  .earlier-dialog[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .earlier-dialog[open] {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
  .earlier-dialog::backdrop {
    background: rgb(8 8 7 / 0);
    backdrop-filter: blur(0);
    transition:
      background 0.3s,
      backdrop-filter 0.3s,
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }
  .earlier-dialog[open]::backdrop {
    background: rgb(8 8 7 / 0.78);
    backdrop-filter: blur(6px);
  }
  @starting-style {
    .earlier-dialog[open]::backdrop {
      background: rgb(8 8 7 / 0);
      backdrop-filter: blur(0);
    }
  }
  :global(html:has(.earlier-dialog[open])) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .earlier-dialog,
    .earlier-dialog::backdrop {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-open]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
    if (!dialog) return;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
